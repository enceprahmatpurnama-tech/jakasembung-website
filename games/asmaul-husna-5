/* =========================================================
   KEYBOARD
========================================================= */

document.addEventListener(
    "keydown",
    function(event){

        if(
            event.key === "1"
        ){

            pilihKeyboard(0);

        }


        if(
            event.key === "2"
        ){

            pilihKeyboard(1);

        }


        if(
            event.key === "3"
        ){

            pilihKeyboard(2);

        }


        if(
            event.key === "4"
        ){

            pilihKeyboard(3);

        }

    }
);


function pilihKeyboard(
    index
){

    if(
        sudahMenjawab
    ){

        return;

    }


    const buttons =
        document.querySelectorAll(
            ".answer"
        );


    if(
        buttons[index]
    ){

        buttons[index].click();

    }

}

