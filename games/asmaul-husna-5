========================================================= */

function jawab(
    index,
    tombol
){

    if(sudahMenjawab){

        return;

    }


    sudahMenjawab = true;


    const data =
        soal[nomor];


    const semua =
        document.querySelectorAll(
            ".answer"
        );


    semua.forEach(
        function(button){

            button.classList.add(
                "disabled"
            );

        }
    );


    const player =
        document.getElementById(
            "player"
        );


    const enemy =
        document.getElementById(
            "enemy"
        );


    const battleText =
        document.getElementById(
            "battleText"
        );


    const feedback =
        document.getElementById(
            "feedback"
        );


    /* =====================================================
       BENAR
    ===================================================== */

    if(
        index === data.benar
    ){

        tombol.classList.add(
            "correct"
        );


        skor += 10;


        document
            .getElementById("skor")
            .textContent =
            skor;


        suara("benar");


        player.classList.add(
            "attack"
        );


        enemy.classList.add(
            "defeat"
        );


        battleText.textContent =
            "⚔️ SERANGAN BERHASIL! 💥";


        buatEfekBenar();


        feedback.className =
            "feedback show correct";


        feedback.innerHTML =

            "🎉 BENAR! Serangan Ninja berhasil!<br><br>" +

            "⭐ +10 POIN<br><br>" +

            data.penjelasan;

    }


    /* =====================================================
       SALAH
    ===================================================== */

    else{

        tombol.classList.add(
            "wrong"
        );


        semua[data.benar]
            .classList.add(
                "correct"
            );


        nyawa--;


        document
            .getElementById("nyawa")
            .textContent =
            "❤️".repeat(nyawa) +
            "🖤".repeat(3-nyawa);


        suara("salah");


        player.classList.add(
            "hit"
        );


        enemy.classList.add(
            "attack"
        );


        battleText.textContent =
            "💥 UPS! MUSUH MENYERANG!";


        buatEfekSalah();


        feedback.className =
            "feedback show wrong";


        feedback.innerHTML =

            "💥 Jawaban belum tepat.<br><br>" +

