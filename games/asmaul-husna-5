========================================================= */

function lanjut(){

    nomor++;


    if(
        nomor >= 30
    ){

        tampilkanBoss();

        return;

    }


    tampilkanSoal();

}


/* =========================================================
   UPDATE GERBANG
========================================================= */

function updateGerbang(
    wilayah
){

    for(
        let i=1;
        i<=5;
        i++
    ){

        const gate =
            document.getElementById(
                "gate"+i
            );


        gate.classList.remove(
            "current"
        );


        if(
            i < wilayah
        ){

            gate.classList.add(
                "done"
            );

        }

    }


    document
        .getElementById(
            "gate"+wilayah
        )
        .classList.add(
            "current"
        );


    for(
        let i=1;
        i<=5;
        i++
    ){

        if(
            i <= wilayah
        ){

            document
                .getElementById(
                    "power"+i
                )
                .classList.add(
                    "active"
                );

        }

    }

}


