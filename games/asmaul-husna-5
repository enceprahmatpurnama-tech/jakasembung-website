<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Ninja Penjaga Asmaul Husna - Kelas 5</title>

<style>

*{
    box-sizing:border-box;
}

body{
    margin:0;
    font-family:Arial,Helvetica,sans-serif;
    color:white;
    min-height:100vh;
    overflow-x:hidden;

    background:
        radial-gradient(
            circle at 20% 10%,
            #7c3aed 0,
            transparent 25%
        ),
        radial-gradient(
            circle at 80% 15%,
            #0ea5e9 0,
            transparent 25%
        ),
        linear-gradient(
            135deg,
            #020617,
            #172554 55%,
            #312e81
        );
}

button{
    font-family:inherit;
}


/* =========================================================
   SCREEN
========================================================= */

.screen{
    display:none;
    min-height:100vh;
    padding:20px;
}

.screen.active{
    display:flex;
    justify-content:center;
    align-items:center;
}


/* =========================================================
   START
========================================================= */

.start-box{
    width:min(1000px,95%);
    background:rgba(15,23,42,.97);
    border:3px solid #8b5cf6;
    border-radius:30px;
    padding:35px 25px;
    text-align:center;

    box-shadow:
        0 0 60px rgba(139,92,246,.35);
}

.ninja-logo{
    font-size:100px;
    animation:ninjaFloat 2s infinite ease-in-out;
}

@keyframes ninjaFloat{

    0%,100%{
        transform:translateY(0);
    }

    50%{
        transform:translateY(-12px);
    }

}

.start-box h1{

    margin:5px 0;

    font-size:
        clamp(
            30px,
            6vw,
            58px
        );

    color:#facc15;

    text-shadow:
        4px 4px #581c87;
}

.start-subtitle{

    max-width:780px;

    margin:
        10px auto 25px;

    font-size:20px;

    line-height:1.5;

    color:#ddd6fe;
}

.start-cards{

    display:grid;

    grid-template-columns:
        repeat(5,1fr);

    gap:10px;

    margin:
        25px 0;
}

.start-card{

    background:#1e293b;

    border:
        1px solid #475569;

    border-radius:15px;

    padding:15px 5px;
}

.start-card-icon{
    font-size:35px;
}

.start-card-name{

    font-weight:bold;

    color:#facc15;

    margin-top:5px;

    font-size:14px;
}

.start-card-meaning{

    font-size:11px;

    color:#cbd5e1;

    margin-top:5px;
}

.start-button,
.restart-button{

    border:none;

    border-radius:18px;

    padding:
        16px 35px;

    background:#22c55e;

    color:white;

    font-size:20px;

    font-weight:bold;

    cursor:pointer;

    box-shadow:
        0 6px 0 #15803d;

    transition:.2s;
}

.start-button:hover,
.restart-button:hover{

    transform:scale(1.05);

}

.start-button:active,
.restart-button:active{

    transform:
        translateY(5px);

    box-shadow:
        0 1px 0 #15803d;
}


/* =========================================================
   GAME
========================================================= */

#gameScreen{
    align-items:flex-start;
}

.game{

    width:
        min(1100px,100%);

    margin:auto;
}


/* =========================================================
   STATUS
========================================================= */

.top-status{

    display:grid;

    grid-template-columns:
        1fr 1fr 1fr;

    gap:10px;

    margin-bottom:12px;
}

.status{

    background:
        rgba(15,23,42,.95);

    border:
        2px solid #334155;

    border-radius:14px;

    text-align:center;

    padding:10px;
}

.status-label{

    font-size:12px;

    color:#94a3b8;
}

.status-value{

    font-size:22px;

    font-weight:bold;

    color:#facc15;

    margin-top:3px;
}

.hearts{

    color:#ef4444;

    letter-spacing:2px;
}


/* =========================================================
   PROGRESS
========================================================= */

.progress-wrap{

    height:16px;

    background:#020617;

    border:
        2px solid #334155;

    border-radius:20px;

    overflow:hidden;

    margin-bottom:14px;
}

.progress{

    height:100%;

    width:0;

    background:
        linear-gradient(
            90deg,
            #22c55e,
            #8b5cf6,
            #facc15
        );

    transition:
        width .4s;
}


/* =========================================================
   MAP
========================================================= */

.map{

    background:
        rgba(15,23,42,.9);

    border:
        2px solid #6366f1;

    border-radius:20px;

    padding:12px;

    margin-bottom:15px;
}

.map-title{

    text-align:center;

    font-weight:bold;

    color:#ddd6fe;

    margin-bottom:10px;
}

.gates{

    display:grid;

    grid-template-columns:
        repeat(5,1fr);

    gap:8px;
}

.gate{

    text-align:center;

    background:#1e293b;

    border:
        2px solid #475569;

    border-radius:13px;

    padding:8px 3px;

    font-size:11px;

    opacity:.5;

    transition:.4s;
}

.gate-icon{

    display:block;

    font-size:28px;

    margin-bottom:3px;
}

.gate.current{

    opacity:1;

    border-color:#facc15;

    background:#713f12;

    transform:
        translateY(-4px);

    box-shadow:
        0 0 22px
        rgba(250,204,21,.45);
}

.gate.done{

    opacity:1;

    border-color:#22c55e;

    background:#14532d;
}


/* =========================================================
   POWER
========================================================= */

.power-bar{

    display:flex;

    justify-content:center;

    gap:7px;

    margin-bottom:12px;

    flex-wrap:wrap;
}

.power{

    background:#1e293b;

    border:
        1px solid #475569;

    border-radius:20px;

    padding:
        6px 12px;

    font-size:12px;

    opacity:.4;

    transition:.3s;
}

.power.active{

    opacity:1;

    border-color:#facc15;

    box-shadow:
        0 0 12px
        rgba(250,204,21,.4);
}


/* =========================================================
   ARENA
========================================================= */

.arena{

    position:relative;

    height:270px;

    overflow:hidden;

    border-radius:25px;

    border:
        3px solid #475569;

    margin-bottom:15px;

    background:

        radial-gradient(
            circle at 78% 22%,
            #fef3c7 0,
            #fde68a 4%,
            transparent 8%
        ),

        linear-gradient(
            #312e81,
            #1e1b4b 55%,
            #172554
        );
}

.stars{

    position:absolute;

    inset:0;

    background-image:
        radial-gradient(
            circle,
            white 1px,
            transparent 2px
        );

    background-size:
        55px 45px;

    opacity:.5;
}

.moon{

    position:absolute;

    right:10%;

    top:22px;

    font-size:50px;

    filter:
        drop-shadow(
            0 0 15px #facc15
        );
}

.cloud{

    position:absolute;

    font-size:50px;

    opacity:.25;
}

.cloud1{

    left:15%;

    top:40px;
}

.cloud2{

    right:30%;

    top:75px;
}

.ground{

    position:absolute;

    bottom:0;

    width:100%;

    height:48px;

    background:
        linear-gradient(
            #365314,
            #1a2e05
        );

    border-top:
        4px solid #4d7c0f;
}

.player{

    position:absolute;

    left:13%;

    bottom:42px;

    font-size:75px;

    z-index:5;
}

.player.attack{

    animation:
        attack .55s ease;
}

@keyframes attack{

    0%{
        transform:
            translateX(0);
    }

    40%{
        transform:
            translateX(120px)
            rotate(-15deg);
    }

    70%{
        transform:
            translateX(135px)
            rotate(15deg);
    }

    100%{
        transform:
            translateX(0);
    }

}

.player.hit{

    animation:
        hit .55s ease;
}

@keyframes hit{

    0%,100%{
        transform:
            translateX(0);
    }

    25%{
        transform:
            translateX(-22px)
            rotate(-10deg);
    }

    50%{
        transform:
            translateX(22px)
            rotate(10deg);
    }

    75%{
        transform:
            translateX(-15px);
    }

}

.enemy{

    position:absolute;

    right:13%;

    bottom:42px;

    font-size:75px;

    z-index:5;
}

.enemy.defeat{

    animation:
        defeat .75s forwards;
}

@keyframes defeat{

    0%{
        transform:scale(1);

        opacity:1;
    }

    45%{
        transform:
            scale(1.3)
            rotate(20deg);
    }

    100%{
        transform:
            scale(.1)
            rotate(100deg)
            translateY(-80px);

        opacity:0;
    }

}

.enemy.attack{

    animation:
        enemyAttack .5s ease;
}

@keyframes enemyAttack{

    0%,100%{
        transform:
            translateX(0);
    }

    50%{
        transform:
            translateX(-100px);
    }

}

.battle-text{

    position:absolute;

    top:17px;

    width:100%;

    text-align:center;

    font-size:22px;

    font-weight:bold;

    color:#facc15;

    text-shadow:
        2px 2px #020617;

    z-index:10;
}


/* =========================================================
   EFFECT
========================================================= */

.effect{

    position:absolute;

    z-index:30;

    pointer-events:none;

    font-size:42px;

    font-weight:bold;
}

.effect.correct{

    animation:
        correctEffect .8s forwards;
}

@keyframes correctEffect{

    0%{
        left:42%;
        top:45%;
        opacity:1;
        transform:scale(.4);
    }

    50%{
        left:65%;
        top:40%;
        opacity:1;
        transform:
            scale(1.6)
            rotate(15deg);
    }

    100%{
        left:75%;
        top:20%;
        opacity:0;
        transform:scale(2);
    }

}

.effect.wrong{

    animation:
        wrongEffect .8s forwards;
}

@keyframes wrongEffect{

    0%{
        left:68%;
        top:40%;
        opacity:1;
        transform:scale(.4);
    }

    50%{
        left:42%;
        top:40%;
        opacity:1;
        transform:scale(1.5);
    }

    100%{
        left:20%;
        top:20%;
        opacity:0;
        transform:scale(2);
    }

}


/* =========================================================
   QUESTION
========================================================= */

.question-box{

    background:#f8fafc;

    color:#0f172a;

    border-radius:25px;

    padding:25px;
}

.question-number{

    color:#4338ca;

    font-weight:bold;
}

.question{

    font-size:
        clamp(
            21px,
            4vw,
            29px
        );

    font-weight:bold;

    line-height:1.45;

    margin:
        12px 0 22px;
}

.answers{

    display:grid;

    gap:11px;
}

.answer{

    border:
        3px solid #cbd5e1;

    background:white;

    color:#0f172a;

    padding:15px;

    border-radius:14px;

    font-size:17px;

    font-weight:bold;

    cursor:pointer;

    text-align:left;

    transition:.2s;
}

.answer:hover{

    border-color:#6366f1;

    background:#eef2ff;

    transform:
        translateX(5px);
}

.answer.correct{

    background:#dcfce7;

    border-color:#22c55e;

    color:#166534;
}

.answer.wrong{

    background:#fee2e2;

    border-color:#ef4444;

    color:#991b1b;
}

.answer.disabled{

    pointer-events:none;
}

.feedback{

    display:none;

    margin-top:15px;

    padding:15px;

    border-radius:14px;

    font-size:17px;

    font-weight:bold;

    line-height:1.5;
}

.feedback.show{

    display:block;
}

.feedback.correct{

    background:#dcfce7;

    color:#166534;
}

.feedback.wrong{

    background:#fee2e2;

    color:#991b1b;
}

.next-wrap{

    text-align:center;

    margin-top:18px;
}

.next-button{

    display:none;

    border:none;

    background:#2563eb;

    color:white;

    padding:14px 25px;

    border-radius:15px;

    font-size:18px;

    font-weight:bold;

    cursor:pointer;

    box-shadow:
        0 5px 0 #1d4ed8;
}

.next-button:hover{

    transform:
        scale(1.04);
}


/* =========================================================
   BOSS
========================================================= */

.boss-screen{

    position:fixed;

    inset:0;

    z-index:100;

    display:none;

    justify-content:center;

    align-items:center;

    background:
        rgba(2,6,23,.92);
}

.boss-screen.show{

    display:flex;
}

.boss-box{

    width:
        min(650px,92%);

    text-align:center;

    background:#1e293b;

    border:
        3px solid #f59e0b;

    border-radius:30px;

    padding:35px;

    box-shadow:
        0 0 60px
        rgba(245,158,11,.4);

    animation:
        bossAppear .5s ease;
}

@keyframes bossAppear{

    from{
        transform:scale(.5);
        opacity:0;
    }

    to{
        transform:scale(1);
        opacity:1;
    }

}

.boss{

    font-size:105px;

    animation:
        bossFloat 1s infinite alternate;
}

@keyframes bossFloat{

    from{
        transform:
            translateY(0);
    }

    to{
        transform:
            translateY(-10px);
    }

}

.boss-title{

    font-size:34px;

    font-weight:bold;

    color:#facc15;
}


/* =========================================================
   RESULT
========================================================= */

.result-box{

    width:
        min(800px,95%);

    background:#0f172a;

    border:
        3px solid #facc15;

    border-radius:30px;

    padding:35px;

    text-align:center;

    box-shadow:
        0 0 50px
        rgba(250,204,21,.25);
}

.trophy{

    font-size:100px;
}

.result-box h1{

    color:#facc15;
}

.final-score{

    font-size:55px;

    font-weight:bold;

    color:#22c55e;
}

.rank{

    font-size:28px;

    color:#ddd6fe;

    margin:12px;
}

.result-message{

    color:#e2e8f0;

    font-size:18px;

    line-height:1.6;

    margin-bottom:25px;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width:800px){

    .start-cards{

        grid-template-columns:
            repeat(3,1fr);
    }

}

@media(max-width:600px){

    .start-cards{

        grid-template-columns:1fr;
    }

    .top-status{

        grid-template-columns:
            repeat(3,1fr);
    }

    .status-value{

        font-size:17px;
    }

    .gates{

        grid-template-columns:
            repeat(3,1fr);
    }

    .arena{

        height:220px;
    }

    .player,
    .enemy{

        font-size:60px;
    }

    .question-box{

        padding:18px;
    }

    .answer{

        font-size:16px;
    }

}

</style>
</head>


