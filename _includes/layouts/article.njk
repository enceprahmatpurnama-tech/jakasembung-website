
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ summary | escape }}">
  <title>{{ (title + ' | ' + site.siteName) | escape }}</title>
  <link rel="canonical" href="{{ (site.url + page.url) | escape }}">
  <meta property="og:type" content="article">
  <meta property="og:title" content="{{ (title + ' | ' + site.siteName) | escape }}">
  <meta property="og:description" content="{{ summary | escape }}">
  <meta property="og:url" content="{{ (site.url + page.url) | escape }}">
  <meta property="og:site_name" content="{{ site.siteName | escape }}">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ (title + ' | ' + site.siteName) | escape }}">
  <meta name="twitter:description" content="{{ summary | escape }}">

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      line-height: 1.8;
      color: #263449;
      background: #f4f8fc;
    }

    header {
      background: #12345a;
      color: white;
      padding: 24px 20px;
    }

    .header-inner,
    main,
    footer {
      max-width: 900px;
      margin: 0 auto;
    }

    .brand {
      margin: 0;
      font-size: 28px;
    }

    .tagline {
      margin: 0;
      color: #d7e8fa;
    }

    nav {
      margin-top: 16px;
    }

    nav a {
      display: inline-block;
      color: white;
      text-decoration: none;
      margin-right: 18px;
      font-size: 14px;
      border-bottom: 2px solid transparent;
      padding-bottom: 3px;
      transition: color 180ms ease, border-color 180ms ease;
    }

    nav a:hover,
    nav a.is-active {
      color: #9ed4ff;
      border-bottom-color: #9ed4ff;
    }

    main {
      background: white;
      margin-top: 32px;
      margin-bottom: 32px;
      padding: 32px;
      border-radius: 12px;
      box-shadow: 0 4px 18px rgba(18, 52, 90, 0.08);
    }

    .category {
      color: #1769aa;
      font-weight: bold;
      font-size: 14px;
    }

    .article-title {
      color: #12345a;
      line-height: 1.3;
    }

    .metadata {
      color: #65758b;
      font-size: 14px;
      border-bottom: 1px solid #e3eaf2;
      padding-bottom: 18px;
      margin-bottom: 24px;
    }

    article h2,
    article h3 {
      color: #12345a;
      margin-top: 28px;
    }

    article p {
      text-align: justify;
    }

    article img {
      display: block;
      max-width: 100%;
      height: auto;
      margin: 24px auto;
      border-radius: 8px;
    }

    .comments {
      margin-top: 36px;
      padding-top: 24px;
      border-top: 1px solid #e3eaf2;
    }

    .comments h2 {
      margin-top: 0;
      color: #12345a;
    }

    .comments-intro {
      color: #65758b;
    }

    .comment-form {
      display: grid;
      gap: 16px;
    }

    .comment-form label {
      display: grid;
      gap: 6px;
      font-weight: bold;
    }

    .comment-form input,
    .comment-form textarea {
      width: 100%;
      padding: 11px 12px;
      border: 1px solid #cbd6e2;
      border-radius: 6px;
      color: #263449;
      font: inherit;
    }

    .comment-form textarea {
      min-height: 130px;
      resize: vertical;
    }

    .comment-form button {
      justify-self: start;
      padding: 11px 18px;
      border: 0;
      border-radius: 6px;
      background: #1769aa;
      color: white;
      font: inherit;
      font-weight: bold;
      cursor: pointer;
    }

    .comment-form button:hover {
      background: #12345a;
    }

    .article-navigation {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      margin-top: 32px;
      padding-top: 20px;
      border-top: 1px solid #e3eaf2;
    }

    .article-navigation a {
      color: #1769aa;
      text-decoration: none;
      font-weight: bold;
    }

    .article-navigation a:hover {
      text-decoration: underline;
    }

    .article-navigation .older {
      margin-left: auto;
      text-align: right;
    }

    footer {
      padding: 24px 20px;
      text-align: center;
      color: #65758b;
      font-size: 14px;
    }

    @media (max-width: 600px) {
      main {
        margin: 16px;
        padding: 22px;
      }

      .brand {
        font-size: 24px;
      }

      nav a {
        margin-right: 10px;
        margin-bottom: 8px;
      }
    }
  </style>
</head>

<body>
  <header>
    <div class="header-inner">
      <p class="brand">{{ site.siteName }}</p>
      <p class="tagline">{{ site.tagline }}</p>

      <nav>
        <a href="/">Beranda</a>
        {% for navCategory in collections.articleCategories %}
        <a href="{{ ('/' + (navCategory.name | slugify) + '/') | escape }}"{% if navCategory.name == category %} class="is-active" aria-current="location"{% endif %}>{{ navCategory.name | escape }}</a>
        {% endfor %}
      </nav>
    </div>
  </header>

  <main>
    <article>
      <p class="category">{{ category }}</p>

      <h1 class="article-title">{{ title }}</h1>
      
      <div class="metadata">
        Terbit: {{ date | dateFormat }}
        {% if updated %}
          | Diperbarui: {{ updated | dateFormat }}
        {% endif %}
      </div>

      {{ content | safe }}
    </article>

    <section class="comments" aria-labelledby="comments-title">
      <h2 id="comments-title">Sampaikan Komentar</h2>
      <p class="comments-intro">Komentar akan dikirim melalui WhatsApp. Email atau nomor WhatsApp Anda boleh dicantumkan agar kami dapat membalas.</p>
      <form class="comment-form" data-whatsapp="{{ site.whatsapp | escape }}" data-article-title="{{ title | escape }}">
        <label for="comment-name">
          Nama
          <input id="comment-name" name="name" type="text" autocomplete="name" required>
        </label>
        <label for="comment-contact">
          Email atau nomor WhatsApp (opsional)
          <input id="comment-contact" name="contact" type="text" autocomplete="email">
        </label>
        <label for="comment-message">
          Komentar
          <textarea id="comment-message" name="message" required></textarea>
        </label>
        <button type="submit">Kirim Komentar via WhatsApp</button>
      </form>
    </section>

    {% set articleLinks = collections.articles | articleNavigation(page.url) %}
    {% if articleLinks.newer or articleLinks.older %}
    <nav class="article-navigation" aria-label="Navigasi artikel">
      {% if articleLinks.newer %}
      <a href="{{ articleLinks.newer.url | escape }}">
        &larr; Artikel lebih baru<br>
        <span>{{ articleLinks.newer.data.title | escape }}</span>
      </a>
      {% endif %}
      {% if articleLinks.older %}
      <a class="older" href="{{ articleLinks.older.url | escape }}">
        Artikel lebih lama &rarr;<br>
        <span>{{ articleLinks.older.data.title | escape }}</span>
      </a>
      {% endif %}
    </nav>
    {% endif %}
  </main>

  <footer>
    <p>© {{ site.siteName }} — {{ site.tagline }}</p>
  </footer>
  <script>
    document.querySelectorAll(".comment-form").forEach((form) => {
      form.addEventListener("submit", (event) => {
        event.preventDefault();

        const formData = new FormData(form);
        const phoneNumber = form.dataset.whatsapp.replace(/\D/g, "");
        const message = [
          `Komentar untuk artikel: ${form.dataset.articleTitle}`,
          `Nama: ${formData.get("name")}`,
          `Email atau nomor WhatsApp: ${formData.get("contact") || "-"}`,
          "",
          "Komentar:",
          formData.get("message")
        ].join("\n");

        window.location.href = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`;
      });
    });
  </script>
</body>
</html>
