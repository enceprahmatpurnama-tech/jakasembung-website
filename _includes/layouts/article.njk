
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ summary | escape }}">
  <title>{{ (title + ' | ' + site.siteName) | escape }}</title>
  <link rel="canonical" href="{{ (site.url + page.url) | escape }}">
  <meta property="og:type" content="article">
  <meta property="og:title" content="{{ (title + ' | ' + site.siteName) | escape }}">
  <meta property="og:description" content="{{ summary | escape }}">
  <meta property="og:url" content="{{ (site.url + page.url) | escape }}">
  <meta property="og:site_name" content="{{ site.siteName | escape }}">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ (title + ' | ' + site.siteName) | escape }}">
  <meta name="twitter:description" content="{{ summary | escape }}">

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      line-height: 1.8;
      color: #263449;
      background: #f4f8fc;
    }

    header {
      background: #12345a;
      color: white;
      padding: 24px 20px;
    }

    .header-inner,
    main,
    footer {
      max-width: 900px;
      margin: 0 auto;
    }

    .brand {
      margin: 0;
      font-size: 28px;
    }

    .tagline {
      margin: 0;
      color: #d7e8fa;
    }

    nav {
      margin-top: 16px;
    }

    nav a {
      display: inline-block;
      color: white;
      text-decoration: none;
      margin-right: 18px;
      font-size: 14px;
      border-bottom: 2px solid transparent;
      padding-bottom: 3px;
      transition: color 180ms ease, border-color 180ms ease;
    }

    nav a:hover,
    nav a.is-active {
      color: #9ed4ff;
      border-bottom-color: #9ed4ff;
    }

    main {
      background: white;
      margin-top: 32px;
      margin-bottom: 32px;
      padding: 32px;
      border-radius: 12px;
      box-shadow: 0 4px 18px rgba(18, 52, 90, 0.08);
    }

    .category {
      color: #1769aa;
      font-weight: bold;
      font-size: 14px;
    }

    .article-title {
      color: #12345a;
      line-height: 1.3;
    }

    .metadata {
      color: #65758b;
      font-size: 14px;
      border-bottom: 1px solid #e3eaf2;
      padding-bottom: 18px;
      margin-bottom: 24px;
    }

    article h2,
    article h3 {
      color: #12345a;
      margin-top: 28px;
    }

    article p {
      text-align: justify;
    }

    article img {
      display: block;
      max-width: 100%;
      height: auto;
      margin: 24px auto;
      border-radius: 8px;
    }

    .comments {
      margin-top: 36px;
      padding-top: 24px;
      border-top: 1px solid #e3eaf2;
    }

    .comments h2 {
      margin-top: 0;
      color: #12345a;
    }

    .comments-intro {
      color: #65758b;
    }

    .comments-status {
      padding: 12px 14px;
      border-radius: 6px;
      background: #f4f8fc;
    }

    .comments-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin: 16px 0;
    }

    .comments-actions button,
    .comment-form button,
    .reply-button,
    .cancel-reply {
      padding: 10px 16px;
      border: 0;
      border-radius: 6px;
      background: #1769aa;
      color: white;
      font: inherit;
      font-weight: bold;
      cursor: pointer;
    }

    .comments-actions button:hover,
    .comment-form button:hover,
    .reply-button:hover,
    .cancel-reply:hover {
      background: #12345a;
    }

    .comments-actions button:disabled,
    .comment-form button:disabled {
      cursor: wait;
      opacity: 0.65;
    }

    .comments-actions .sign-out-button,
    .cancel-reply {
      background: #65758b;
    }

    .comment-list,
    .comment-replies {
      display: grid;
      gap: 16px;
    }

    .comment-entry {
      padding: 16px;
      border: 1px solid #e3eaf2;
      border-radius: 8px;
      overflow-wrap: anywhere;
    }

    .comment-entry-header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 4px 16px;
      color: #65758b;
      font-size: 14px;
    }

    .comment-entry-header strong {
      color: #12345a;
    }

    .comment-entry p {
      margin: 10px 0;
      white-space: pre-wrap;
    }

    .comment-replies {
      margin: 16px 0 0 18px;
      padding-left: 16px;
      border-left: 2px solid #e3eaf2;
    }

    .comment-form[hidden],
    .comments-actions button[hidden],
    .reply-context[hidden] {
      display: none;
    }

    .reply-context {
      margin: 0;
      color: #65758b;
    }

    .comment-form {
      display: grid;
      gap: 16px;
      margin-top: 16px;
    }

    .comment-form label {
      display: grid;
      gap: 6px;
      font-weight: bold;
    }

    .comment-form textarea {
      width: 100%;
      padding: 11px 12px;
      border: 1px solid #cbd6e2;
      border-radius: 6px;
      color: #263449;
      font: inherit;
    }

    .comment-form textarea {
      min-height: 130px;
      resize: vertical;
    }

    .whatsapp-comments {
      margin-top: 32px;
      padding-top: 24px;
      border-top: 1px solid #e3eaf2;
    }

    .whatsapp-comments h3 {
      color: #12345a;
    }

    .article-navigation {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      margin-top: 32px;
      padding-top: 20px;
      border-top: 1px solid #e3eaf2;
    }

    .article-navigation a {
      color: #1769aa;
      text-decoration: none;
      font-weight: bold;
    }

    .article-navigation a:hover {
      text-decoration: underline;
    }

    .article-navigation .older {
      margin-left: auto;
      text-align: right;
    }

    footer {
      padding: 24px 20px;
      text-align: center;
      color: #65758b;
      font-size: 14px;
    }

    @media (max-width: 600px) {
      main {
        margin: 16px;
        padding: 22px;
      }

      .brand {
        font-size: 24px;
      }

      nav a {
        margin-right: 10px;
        margin-bottom: 8px;
      }
    }
  </style>
</head>

<body>
  <header>
    <div class="header-inner">
      <p class="brand">{{ site.siteName }}</p>
      <p class="tagline">{{ site.tagline }}</p>

      <nav>
        <a href="/">Beranda</a>
        {% for navCategory in collections.articleCategories %}
        <a href="{{ ('/' + (navCategory.name | slugify) + '/') | escape }}"{% if navCategory.name == category %} class="is-active" aria-current="location"{% endif %}>{{ navCategory.name | escape }}</a>
        {% endfor %}
      </nav>
    </div>
  </header>

  <main>
    <article>
      <p class="category">{{ category }}</p>

      <h1 class="article-title">{{ title }}</h1>
      
      <div class="metadata">
        Terbit: {{ date | dateFormat }}
        {% if updated %}
          | Diperbarui: {{ updated | dateFormat }}
        {% endif %}
      </div>

      {{ content | safe }}
    </article>

    <section class="comments" aria-labelledby="comments-title">
      <h2 id="comments-title">Komentar Pengunjung</h2>
      <p class="comments-intro">Baca komentar pengunjung lain dan balas dalam diskusi. Masuk dengan Google untuk menulis atau membalas. Nama profil Google akan terlihat publik; alamat email tidak ditampilkan bersama komentar.</p>
      <div
        id="comments-config"
        data-api-key="{{ firebase.apiKey | escape }}"
        data-auth-domain="{{ firebase.authDomain | escape }}"
        data-project-id="{{ firebase.projectId | escape }}"
        data-app-id="{{ firebase.appId | escape }}"
        data-article-id="{{ page.url | escape }}"
      ></div>
      <p id="comments-status" class="comments-status" role="status" aria-live="polite">Memuat komentar...</p>
      <div class="comments-actions">
        <button id="google-sign-in" type="button" hidden>Masuk dengan Google</button>
        <button id="google-sign-out" class="sign-out-button" type="button" hidden>Keluar</button>
      </div>
      <form id="public-comment-form" class="comment-form" hidden>
        <p id="reply-context" class="reply-context" hidden>
          Membalas komentar <strong id="reply-author"></strong>
          <button id="cancel-reply" class="cancel-reply" type="button">Batal</button>
        </p>
        <label for="public-comment-message">Komentar</label>
        <textarea id="public-comment-message" name="message" maxlength="2000" required></textarea>
        <button id="public-comment-submit" type="submit">Kirim komentar</button>
      </form>
      <div id="public-comment-list" class="comment-list" aria-live="polite"></div>

      <div class="whatsapp-comments">
        <h3>Kirim komentar pribadi via WhatsApp</h3>
        <p class="comments-intro">Jika lebih nyaman menyampaikan komentar secara pribadi, kirim langsung melalui WhatsApp.</p>
        <form class="whatsapp-comment-form" data-whatsapp="{{ site.whatsapp | escape }}" data-article-title="{{ title | escape }}">
          <label for="whatsapp-comment-name">
            Nama
            <input id="whatsapp-comment-name" name="name" type="text" autocomplete="name" required>
          </label>
          <label for="whatsapp-comment-contact">
            Email atau nomor WhatsApp (opsional)
            <input id="whatsapp-comment-contact" name="contact" type="text" autocomplete="email">
          </label>
          <label for="whatsapp-comment-message">
            Komentar
            <textarea id="whatsapp-comment-message" name="message" required></textarea>
          </label>
          <button type="submit">Kirim via WhatsApp</button>
        </form>
      </div>
    </section>

    {% set articleLinks = collections.articles | articleNavigation(page.url) %}
    {% if articleLinks.newer or articleLinks.older %}
    <nav class="article-navigation" aria-label="Navigasi artikel">
      {% if articleLinks.newer %}
      <a href="{{ articleLinks.newer.url | escape }}">
        &larr; Artikel lebih baru<br>
        <span>{{ articleLinks.newer.data.title | escape }}</span>
      </a>
      {% endif %}
      {% if articleLinks.older %}
      <a class="older" href="{{ articleLinks.older.url | escape }}">
        Artikel lebih lama &rarr;<br>
        <span>{{ articleLinks.older.data.title | escape }}</span>
      </a>
      {% endif %}
    </nav>
    {% endif %}
  </main>

  <footer>
    <p>© {{ site.siteName }} — {{ site.tagline }}</p>
  </footer>
  <script type="module">
    document.querySelectorAll(".whatsapp-comment-form").forEach((form) => {
      form.addEventListener("submit", (event) => {
        event.preventDefault();

        const formData = new FormData(form);
        const phoneNumber = form.dataset.whatsapp.replace(/\D/g, "");
        const message = [
          `Komentar untuk artikel: ${form.dataset.articleTitle}`,
          `Nama: ${formData.get("name")}`,
          `Email atau nomor WhatsApp: ${formData.get("contact") || "-"}`,
          "",
          "Komentar:",
          formData.get("message")
        ].join("\n");

        window.location.href = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`;
      });
    });

    const configElement = document.querySelector("#comments-config");
    const statusElement = document.querySelector("#comments-status");
    const signInButton = document.querySelector("#google-sign-in");
    const signOutButton = document.querySelector("#google-sign-out");
    const commentForm = document.querySelector("#public-comment-form");
    const messageInput = document.querySelector("#public-comment-message");
    const submitButton = document.querySelector("#public-comment-submit");
    const commentList = document.querySelector("#public-comment-list");
    const replyContext = document.querySelector("#reply-context");
    const replyAuthor = document.querySelector("#reply-author");
    const cancelReplyButton = document.querySelector("#cancel-reply");
    const firebaseConfig = {
      apiKey: configElement.dataset.apiKey,
      authDomain: configElement.dataset.authDomain,
      projectId: configElement.dataset.projectId,
      appId: configElement.dataset.appId
    };
    const isConfigured = Object.values(firebaseConfig).every(Boolean);

    function setReplyTarget(comment) {
      replyContext.hidden = !comment;
      replyAuthor.textContent = comment ? comment.authorName : "";
      commentForm.dataset.parentId = comment ? comment.id : "";
      if (comment) messageInput.focus();
    }

    function buildCommentTree() {
      const nodes = comments.map((comment) => ({ ...comment, children: [] }));
      const byId = new Map(nodes.map((comment) => [comment.id, comment]));
      const roots = [];
      for (const comment of nodes) {
        const parent = comment.parentId ? byId.get(comment.parentId) : null;
        if (parent) parent.children.push(comment);
        else roots.push(comment);
      }
      return roots;
    }

    function renderCommentList(user) {
      const roots = buildCommentTree();
      commentList.replaceChildren(...roots.map((comment) =>
        renderComment(comment, comment.children, user)
      ));
      if (comments.length === 0) {
        const emptyMessage = document.createElement("p");
        emptyMessage.textContent = "Belum ada komentar. Jadilah yang pertama memulai diskusi.";
        commentList.append(emptyMessage);
      }
    }

    function renderComment(comment, replies, user) {
      const entry = document.createElement("article");
      entry.className = "comment-entry";

      const header = document.createElement("div");
      header.className = "comment-entry-header";
      const author = document.createElement("strong");
      author.textContent = comment.authorName || "Pengunjung";
      const date = document.createElement("time");
      if (comment.createdAt && typeof comment.createdAt.toDate === "function") {
        const createdAt = comment.createdAt.toDate();
        date.dateTime = createdAt.toISOString();
        date.textContent = createdAt.toLocaleString("id-ID");
      } else {
        date.textContent = "Baru saja";
      }
      header.append(author, date);

      const content = document.createElement("p");
      content.textContent = comment.text;
      entry.append(header, content);

      if (user) {
        const replyButton = document.createElement("button");
        replyButton.className = "reply-button";
        replyButton.type = "button";
        replyButton.textContent = "Balas";
        replyButton.addEventListener("click", () => setReplyTarget(comment));
        entry.append(replyButton);
      }

      if (replies.length > 0) {
        const replyList = document.createElement("div");
        replyList.className = "comment-replies";
        for (const reply of replies) {
          replyList.append(renderComment(reply, reply.children, user));
        }
        entry.append(replyList);
      }

      return entry;
    }

    if (!isConfigured) {
      statusElement.textContent = "Komentar publik belum aktif. Admin perlu mengisi konfigurasi Firebase; komentar via WhatsApp tetap tersedia di bawah.";
      signInButton.hidden = true;
    } else {
      try {
        const version = "11.10.0";
        const baseUrl = `https://www.gstatic.com/firebasejs/${version}`;
        const [
          { initializeApp },
          { getAuth, GoogleAuthProvider, onAuthStateChanged, signInWithPopup, signOut },
          { getFirestore, collection, addDoc, onSnapshot, orderBy, query, serverTimestamp, where }
        ] = await Promise.all([
          import(`${baseUrl}/firebase-app.js`),
          import(`${baseUrl}/firebase-auth.js`),
          import(`${baseUrl}/firebase-firestore.js`)
        ]);
        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);
        const commentsQuery = query(
          collection(db, "comments"),
          where("articleId", "==", configElement.dataset.articleId),
          orderBy("createdAt", "asc")
        );
        let currentUser = null;
        let comments = [];

        onSnapshot(commentsQuery, (snapshot) => {
          comments = snapshot.docs.map((document) => ({
            id: document.id,
            ...document.data()
          }));
          renderCommentList(currentUser);
          if (!statusElement.dataset.error) {
            statusElement.textContent = `${comments.length} komentar`;
          }
        }, (error) => {
          console.error("Gagal memuat komentar publik:", error);
          statusElement.dataset.error = "true";
          statusElement.textContent = "Komentar tidak dapat dimuat. Silakan coba lagi nanti.";
        });

        onAuthStateChanged(auth, (user) => {
          currentUser = user;
          signInButton.hidden = Boolean(user);
          signOutButton.hidden = !user;
          commentForm.hidden = !user;
          renderCommentList(user);
        });

        signInButton.addEventListener("click", async () => {
          signInButton.disabled = true;
          try {
            await signInWithPopup(auth, new GoogleAuthProvider());
          } catch (error) {
            console.error("Gagal masuk dengan Google:", error);
            statusElement.textContent = "Login Google gagal. Pastikan Google Authentication telah diaktifkan.";
          } finally {
            signInButton.disabled = false;
          }
        });

        signOutButton.addEventListener("click", async () => {
          try {
            await signOut(auth);
            setReplyTarget(null);
          } catch (error) {
            console.error("Gagal keluar dari akun Google:", error);
            statusElement.textContent = "Tidak dapat keluar dari akun. Silakan coba lagi.";
          }
        });

        commentForm.addEventListener("submit", async (event) => {
          event.preventDefault();
          if (!currentUser) return;

          const text = messageInput.value.trim();
          if (!text || text.length > 2000) return;

          submitButton.disabled = true;
          try {
            await addDoc(collection(db, "comments"), {
              articleId: configElement.dataset.articleId,
              authorName: currentUser.displayName || "Pengunjung",
              text,
              parentId: commentForm.dataset.parentId || null,
              createdAt: serverTimestamp()
            });
            messageInput.value = "";
            setReplyTarget(null);
            statusElement.dataset.error = "";
            statusElement.textContent = "Komentar berhasil dikirim.";
          } catch (error) {
            console.error("Gagal mengirim komentar publik:", error);
            statusElement.textContent = "Komentar gagal dikirim. Pastikan Firestore dan aturan akses sudah dikonfigurasi.";
          } finally {
            submitButton.disabled = false;
          }
        });

        cancelReplyButton.addEventListener("click", () => setReplyTarget(null));
      } catch (error) {
        console.error("Gagal menginisialisasi komentar publik:", error);
        statusElement.textContent = "Layanan komentar tidak dapat diinisialisasi. Komentar via WhatsApp tetap tersedia di bawah.";
      }
    }
  </script>
</body>
</html>
