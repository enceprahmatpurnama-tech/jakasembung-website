
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ summary | escape }}">
  <title>{{ (title + ' | ' + site.siteName) | escape }}</title>
  <link rel="canonical" href="{{ (site.url + page.url) | escape }}">
  <meta property="og:type" content="article">
  <meta property="og:title" content="{{ (title + ' | ' + site.siteName) | escape }}">
  <meta property="og:description" content="{{ summary | escape }}">
  <meta property="og:url" content="{{ (site.url + page.url) | escape }}">
  <meta property="og:site_name" content="{{ site.siteName | escape }}">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ (title + ' | ' + site.siteName) | escape }}">
  <meta name="twitter:description" content="{{ summary | escape }}">

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      line-height: 1.8;
      color: #263449;
      background: #f4f8fc;
    }

    header {
      background: #12345a;
      color: white;
      padding: 24px 20px;
    }

    .header-inner,
    main,
    footer {
      max-width: 900px;
      margin: 0 auto;
    }

    .brand {
      margin: 0;
      font-size: 28px;
    }

    .tagline {
      margin: 0;
      color: #d7e8fa;
    }

    nav {
      margin-top: 16px;
    }

    nav a {
      display: inline-block;
      color: white;
      text-decoration: none;
      margin-right: 18px;
      font-size: 14px;
    }

    main {
      background: white;
      margin-top: 32px;
      margin-bottom: 32px;
      padding: 32px;
      border-radius: 12px;
      box-shadow: 0 4px 18px rgba(18, 52, 90, 0.08);
    }

    .category {
      color: #1769aa;
      font-weight: bold;
      font-size: 14px;
    }

    .article-title {
      color: #12345a;
      line-height: 1.3;
    }

    .metadata {
      color: #65758b;
      font-size: 14px;
      border-bottom: 1px solid #e3eaf2;
      padding-bottom: 18px;
      margin-bottom: 24px;
    }

    article h2,
    article h3 {
      color: #12345a;
      margin-top: 28px;
    }

    footer {
      padding: 24px 20px;
      text-align: center;
      color: #65758b;
      font-size: 14px;
    }

    @media (max-width: 600px) {
      main {
        margin: 16px;
        padding: 22px;
      }

      .brand {
        font-size: 24px;
      }

      nav a {
        margin-right: 10px;
        margin-bottom: 8px;
      }
    }
  </style>
</head>

<body>
  <header>
    <div class="header-inner">
      <p class="brand">{{ site.siteName }}</p>
      <p class="tagline">{{ site.tagline }}</p>

      <nav>
        <a href="/">Beranda</a>
      </nav>
    </div>
  </header>

  <main>
    <article>
      <p class="category">{{ category }}</p>

      <h1 class="article-title">{{ title }}</h1>
      
      <div class="metadata">
        Terbit: {{ date | dateFormat }}
        {% if updated %}
          | Diperbarui: {{ updated | dateFormat }}
        {% endif %}
      </div>

      {{ content | safe }}
    </article>
  </main>

  <footer>
    <p>© {{ site.siteName }} — {{ site.tagline }}</p>
  </footer>
</body>
</html>
